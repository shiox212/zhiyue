# Local configuration: copy to .env, which is ignored by Git.
DB_URL=jdbc:mysql://localhost:3306/ebook_recommend_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8081
# Generate at least 32 random bytes, encoded as Base64. Never commit a real key.
JWT_SECRET_BASE64=GENERATE_A_RANDOM_BASE64_KEY
# Only localhost HTTP may use false. Use true with HTTPS.
COOKIE_SECURE=false
# Model calls are disabled until a real local key is supplied. Never put this key in frontend config.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
